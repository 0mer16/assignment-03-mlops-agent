# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- MLflow ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# --- Airflow ---
AIRFLOW_API_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=admin
# Airflow 3 standalone writes a generated password to
# $AIRFLOW_HOME/simple_auth_manager_passwords.json.generated
AIRFLOW_PASSWORD=

# --- Kubernetes ---
KUBECONFIG=.kube/config
K8S_NAMESPACE=mlops
K8S_DEPLOYMENT=inference-api

# --- Safety policy ---
# Comma separated. Anything outside these lists is refused before a call is made.
APPROVED_NAMESPACES=mlops
APPROVED_DAGS=training_pipeline

# --- Agent ---
# auto uses Gemini when a key is present and the deterministic planner otherwise.
AGENT_PLANNER=auto
TOOL_TIMEOUT_SECONDS=30
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
